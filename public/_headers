/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self' https://api.dropboxapi.com https://content.dropboxapi.com https://api.dictionaryapi.dev https://api.datamuse.com https://openlibrary.org https://www.googleapis.com https://musicbrainz.org https://coverartarchive.org https://itunes.apple.com https://www.wikidata.org https://en.wikipedia.org https://api.lemonsqueezy.com https://api.github.com; manifest-src 'self'; worker-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), microphone=(self), geolocation=()

/
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

# The dataviewjs sandbox (src/dataview.js) runs note scripts, so it gets its
# own policy: inline and eval'd script, but no network at all, and no images
# from the web. It's only ever loaded in <iframe sandbox="allow-scripts">.
/dv-sandbox
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'unsafe-inline' 'unsafe-eval'; style-src 'unsafe-inline'; img-src data:; base-uri 'none'; form-action 'none'
  Cache-Control: no-cache

/dv-sandbox.html
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'unsafe-inline' 'unsafe-eval'; style-src 'unsafe-inline'; img-src data:; base-uri 'none'; form-action 'none'
  Cache-Control: no-cache

# Tesseract's engine (src/localocr.js) is WebAssembly, which needs
# wasm-unsafe-eval (also in the page's policy, for browsers that give a worker
# its page's policy). Versioned paths never change.
/ocr/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self'; base-uri 'none'
  Cache-Control: public, max-age=31536000, immutable
