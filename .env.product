# The product build: wr1t3r for anyone, at https://user.wr1t3r.app, keeping
# notes in each person's own Dropbox. `npm run deploy:product` builds with
# this file plus .env.product.local (not in git), where the real IDs go:
#
#   VITE_DROPBOX_APP_KEY=...   the Dropbox app's App key
#   VITE_LS_STORE_ID=...       Lemon Squeezy store ID
#   VITE_LS_PRODUCT_ID=...     Lemon Squeezy product ID
#   VITE_BUY_URL=...           the product's checkout link
#
# None of these are secrets (they end up in the page), they just aren't
# anyone else's to build with.
VITE_DROPBOX_ONLY=1
