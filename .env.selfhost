# The self-host build: the same page as the product build (notes in the
# person's own Dropbox, no Worker needed), with no license check, for anyone
# who hosts their own copy for free. `npm run build:selfhost` builds with this
# file. The one thing it needs, VITE_DROPBOX_APP_KEY, comes from the host's
# build settings (Cloudflare's build variables, or the GitHub Pages workflow's
# DROPBOX_APP_KEY variable), or from .env.selfhost.local when building by hand.
# Guide: site/pages/self-host.md (https://wr1t3r.app/self-host.html).
VITE_DROPBOX_ONLY=1
VITE_SELF_HOST=1
